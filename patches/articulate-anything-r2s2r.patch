+def _node_pose(scene, geom_name):
+    """Pose to render a geometry at: its node's transform, identity when it has none.
+    Camera placement uses the transformed scene (extents, centroid), and SimFoundry's
+    canonical meshes keep their scale and uprighting rotation in the scene graph."""
+    try:
+        return _geometry_transform(scene, geom_name)
+    except (KeyError, ValueError):
+        return np.eye(4)
+
+
+def _geometry_transform(scene, geom_name):
+    """World transform of a scene geometry. GLB node names can differ from geometry
+    names (node "textured_mesh" holding geometry "textured_mesh.001")."""
+    nodes = scene.graph.geometry_nodes.get(geom_name) or [geom_name]
+    transform, _ = scene.graph[nodes[0]]
+    return transform
+
